        </mxCell>
        <mxCell id="e4" value="4. Запись в реестр ⚠️" style="endArrow=block;endFill=1;fontSize=12;strokeColor=#e74c3c;" edge="1" source="proc_enter" target="ds_r1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. Чтение реестра ⚠️&#xa;(нет фильтрации по пациенту)" style="endArrow=block;endFill=1;fontSize=12;strokeColor=#e74c3c;" edge="1" source="proc_view" target="ds_r2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. Просматривает результаты ⚠️" style="endArrow=block;endFill=1;fontSize=12;strokeColor=#e74c3c;" edge="1" source="doc" target="proc_view" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7. Нет доступа к своим анализам ⚠️" style="endArrow=block;endFill=1;fontSize=12;strokeColor=#e74c3c;dashed=1;" edge="1" source="pat" target="ds_rn" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

