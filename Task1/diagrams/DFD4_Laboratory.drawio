<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="DFD4 - Лаборатория" id="dfd4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="DFD 4 — Учёт лабораторных анализов (AS-IS)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="327" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- External lab -->
        <mxCell id="lab" value="🏥 Внешняя лаборатория&#xa;(внешняя система)&#xa;⚠️ Нет API-интеграции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="adm" value="🧑‍💼 Администратор&#xa;ресепшена" style="shape=mxgraph.c4.person2;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="doc" value="👨‍⚕️ Врач" style="shape=mxgraph.c4.person2;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="400" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pat" value="🧑 Пациент&#xa;⚠️ Нет личного кабинета" style="shape=mxgraph.c4.person2;fillColor=#6c757d;fontColor=#ffffff;strokeColor=#4d4d4d;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="650" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- Processes -->
        <mxCell id="proc_recv" value="⚙️ Получение результатов&#xa;от лаборатории&#xa;(email / файлы)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="proc_enter" value="⚙️ Ручное внесение&#xa;данных в реестр&#xa;⚠️ Нет проверки целостности" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="proc_view" value="⚙️ Просмотр результатов&#xa;анализов врачом&#xa;⚠️ Видит данные всех пациентов" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- File server / lab registry -->
        <mxCell id="fs_bound" value="📁 Файловый сервер — папка Laboratory Registry&#xa;⚠️ Нет шифрования, нет RBAC" style="swimlane;startSize=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="380" width="280" height="420" as="geometry" />
        </mxCell>

        <mxCell id="ds_r1" value="📄 RegistryByDate_1.xlsx&#xa;⚠️ Все пациенты за день" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="fs_bound">
          <mxGeometry x="20" y="70" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ds_r2" value="📄 RegistryByDate_2.xlsx&#xa;⚠️ Все пациенты за день" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="fs_bound">
          <mxGeometry x="20" y="180" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ds_rn" value="📄 RegistryByDate_N.xlsx&#xa;⚠️ Все пациенты за день" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="fs_bound">
          <mxGeometry x="20" y="290" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Risk boxes -->
        <mxCell id="risk1" value="🔴 РИСК: Нет API-контракта.&#xa;Данные анализов передаются&#xa;по email без шифрования.&#xa;Нет верификации целостности." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#e74c3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="risk2" value="🔴 РИСК: Один реестр за день&#xa;содержит данные ВСЕХ пациентов.&#xa;Любой врач / сотрудник видит&#xa;чужие анализы (нет row-level security)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#e74c3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="840" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="risk3" value="🔴 РИСК: Пациент не имеет&#xa;доступа к своим анализам.&#xa;Нет личного кабинета." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#e74c3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="820" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="1. Направление на анализ" style="endArrow=block;endFill=1;fontSize=12;" edge="1" source="lab" target="proc_recv" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. Результаты анализов ⚠️&#xa;email или файлы, без шифрования" style="endArrow=block;endFill=1;fontSize=12;strokeColor=#e74c3c;fontColor=#e74c3c;" edge="1" source="proc_recv" target="adm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. Передача данных для ввода" style="endArrow=block;endFill=1;fontSize=12;" edge="1" source="adm" target="proc_enter" parent="1">
